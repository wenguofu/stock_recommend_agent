# ── 数据库 (必填 MySQL DSN, 未设启动报错) ──
DATABASE_URL=mysql+pymysql://stock_user:change-me@127.0.0.1:3306/stock_trading

# ── 后端 ──
API_PORT=35000
A_STOCK_API=http://127.0.0.1:35000
FLASK_DEBUG=0

# ── 安全 ──
# 设为 1 启用 API 认证，留空或 0 关闭
AUTH_ENABLED=0
# Bearer token（环境变量优先 > DB存储）
AUTH_TOKEN=change-me-to-a-random-string

# ── AI 服务密钥（替换为你的实际密钥）──
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx
QWEN_API_KEY=sk-xxx
GEMINI_API_KEY=sk-xxx
GROK_API_KEY=sk-xxx

# ── 前端（Vite 自动加载）──
VITE_API_BASE_URL=http://127.0.0.1:35000
